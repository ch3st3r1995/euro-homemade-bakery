---
// Homepage-only: practical info (hours/map) + a lightweight Instagram
// prompt. "Our Story" and the full contact form deliberately live on their
// own dedicated pages (About / Contact) instead of being duplicated here --
// see docs/superpowers/specs/2026-07-24-visual-redesign-design.md.
import HoursAddressMap from './HoursAddressMap.astro';
import InstagramIcon from './InstagramIcon.astro';
import { ui, type Locale } from '../i18n/ui';
import { INSTAGRAM_URL } from '../consts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<section class="connect-section reveal">
  <HoursAddressMap locale={locale} />
  <div class="connect-side">
    <div class="instagram-card">
      <h2>{t.instagramCta}</h2>
      <p>{t.instagramBlurb}</p>
      <a class="instagram-cta" href={INSTAGRAM_URL} rel="noopener noreferrer" target="_blank">
        <InstagramIcon size={20} />
        {t.instagramCta}
      </a>
    </div>
  </div>
</section>

<style>
  .connect-section {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 12px 24px;
  }
  .connect-side {
    display: flex;
    align-items: center;
    padding: 40px 32px 40px 0;
  }
  .instagram-card {
    width: 100%;
    background: #fff;
    border-radius: 10px;
    padding: 28px;
    box-shadow: 0 4px 16px rgba(58, 42, 28, 0.08);
  }
  .instagram-card p {
    margin: 0 0 18px;
  }
  .instagram-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 12px 20px;
    border-radius: 999px;
    text-decoration: none;
    background: linear-gradient(45deg, #f9ce34, #ee2a7b, #6228d7);
    color: #fff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .instagram-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(238, 42, 123, 0.35);
  }
  @media (max-width: 900px) {
    .connect-section {
      grid-template-columns: 1fr;
    }
    .connect-side {
      padding: 0 32px 40px;
    }
  }
</style>
