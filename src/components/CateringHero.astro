---
import { ui, type Locale } from '../i18n/ui';
import { PHONE } from '../consts';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  locale: Locale;
  heading: string;
  intro: string;
}

const { locale, heading, intro } = Astro.props;
const t = ui[locale];
---

<section class="catering-hero">
  <div class="catering-text">
    <h1>{heading}</h1>
    <p>{intro}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href={PHONE.href}>{t.catering.callToOrder}</a>
      <a class="btn btn-outline" href={getRelativeLocaleUrl(locale, 'contact')}>{t.catering.sendMessage}</a>
    </div>
  </div>
  <div class="catering-photo">
    <img src="/images/catering/catering-spread.webp" alt="" loading="eager" />
  </div>
</section>

<style>
  .catering-hero {
    display: flex;
    min-height: 320px;
  }
  .catering-text {
    flex: 1;
    padding: 48px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  .catering-text p {
    max-width: 420px;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  .btn {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 11px 20px;
    border-radius: 6px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn-primary {
    background: var(--color-accent, #c96f42);
    color: var(--color-accent-contrast, #fff8ef);
  }
  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-accent, #c96f42);
    color: var(--color-accent, #c96f42);
  }
  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(201, 111, 66, 0.4);
  }
  .catering-photo {
    flex: 1;
    overflow: hidden;
  }
  .catering-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  @media (max-width: 720px) {
    .catering-hero {
      flex-direction: column;
    }
    .catering-photo {
      height: 260px;
    }
  }
</style>
