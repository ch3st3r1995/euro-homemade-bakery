---
import { ui, type Locale } from '../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  locale: Locale;
  body: string;
}

const { locale, body } = Astro.props;
const t = ui[locale];
---

<div class="story-teaser">
  <h2>{t.story.heading}</h2>
  <p>{body}</p>
  <a class="read-more" href={getRelativeLocaleUrl(locale, 'about')}>{t.story.readMore} →</a>
</div>

<style>
  .story-teaser {
    background: #fff;
    border-radius: 10px;
    padding: 28px;
    box-shadow: 0 4px 16px rgba(58, 42, 28, 0.08);
  }
  .story-teaser p {
    margin: 0 0 14px;
  }
  .read-more {
    font-weight: 500;
    color: var(--color-accent, #c96f42);
    text-decoration: none;
  }
  .read-more:hover {
    text-decoration: underline;
  }
</style>
