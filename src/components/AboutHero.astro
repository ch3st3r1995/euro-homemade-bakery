---
interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<section class="about-hero">
  <div class="about-text">
    <h1>{heading}</h1>
    <slot />
  </div>
  <div class="about-photo">
    <img src="/images/history/owners.png" alt="" loading="eager" />
  </div>
</section>

<style>
  .about-hero {
    display: flex;
    min-height: 320px;
    align-items: stretch;
  }
  .about-text {
    flex: 1;
    padding: 48px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    max-width: 560px;
  }
  .about-photo {
    flex: 1;
    overflow: hidden;
  }
  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  @media (max-width: 720px) {
    .about-hero {
      flex-direction: column;
    }
    .about-text {
      max-width: 100%;
    }
    .about-photo {
      height: 280px;
    }
  }
</style>
