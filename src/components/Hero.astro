---
import OrderOnlineLinks from './OrderOnlineLinks.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  heading: string;
  subheading: string;
}

const { locale, heading, subheading } = Astro.props;
---

<section class="hero">
  <div class="hero-text">
    <h1>{heading}</h1>
    <p>{subheading}</p>
    <OrderOnlineLinks locale={locale} />
  </div>
  <div class="hero-photo">
    <img src="/images/hero/bread-banner.png" alt="" loading="eager" />
  </div>
</section>

<style>
  .hero {
    display: flex;
    min-height: 320px;
  }
  .hero-text {
    flex: 1;
    padding: 48px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  .hero-text h1 {
    font-size: 2.25rem;
  }
  .hero-text p {
    max-width: 420px;
  }
  .hero-photo {
    flex: 1;
    overflow: hidden;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  @media (max-width: 720px) {
    .hero {
      flex-direction: column;
    }
    .hero-photo {
      height: 260px;
    }
  }
</style>
