---
import { ui, type Locale } from '../i18n/ui';
import { DOORDASH_URL, UBER_EATS_URL } from '../consts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<div class="order-online-links">
  <a class="btn btn-primary" href={DOORDASH_URL} rel="noopener noreferrer" target="_blank">{t.orderOnline.doordash}</a>
  <a class="btn btn-outline" href={UBER_EATS_URL} rel="noopener noreferrer" target="_blank">{t.orderOnline.ubereats}</a>
</div>

<style>
  .order-online-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 11px 20px;
    border-radius: 6px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn-primary {
    background: var(--color-accent, #c96f42);
    color: var(--color-accent-contrast, #fff8ef);
  }
  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-accent, #c96f42);
    color: var(--color-accent, #c96f42);
  }
  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(201, 111, 66, 0.4);
  }
</style>
