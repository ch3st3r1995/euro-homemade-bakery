---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HoursAddressMap from '../../components/HoursAddressMap.astro';

const locale = 'pl' as const;
const entry = await getEntry(locale, 'contact');
if (!entry) throw new Error(`Missing contact content entry for locale "${locale}"`);
const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} path="contact">
  <h1>{entry.data.title}</h1>
  <Content />

  <form id="contact-form">
    <label>Imię <input type="text" name="name" required /></label>
    <label>Adres e-mail <input type="email" name="email" required /></label>
    <label>Telefon <input type="tel" name="phone" /></label>
    <label>Wiadomość <textarea name="message" required></textarea></label>
    <button type="submit">Wyślij</button>
    <p id="contact-form-status" role="status"></p>
  </form>

  <HoursAddressMap locale={locale} />
</BaseLayout>

<script>
  // CORS is handled entirely at the API Gateway level (infra/modules/contact-form),
  // not by this page or the Lambda -- see the project's infra plan.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');
  const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    if (!endpoint) {
      status.textContent = 'Formularz kontaktowy nie jest jeszcze skonfigurowany -- prosimy zadzwonić lub napisać do nas bezpośrednio.';
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries());
    status.textContent = 'Wysyłanie...';

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!response.ok) throw new Error(`Request failed: ${response.status}`);
      status.textContent = 'Dziękujemy -- otrzymaliśmy Twoją wiadomość i wkrótce się odezwiemy.';
      form.reset();
    } catch {
      status.textContent = 'Coś poszło nie tak -- prosimy zadzwonić lub napisać do nas bezpośrednio.';
    }
  });
</script>
