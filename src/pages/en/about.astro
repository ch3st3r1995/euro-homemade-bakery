---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutHero from '../../components/AboutHero.astro';
import { ui } from '../../i18n/ui';

const locale = 'en' as const;
const entry = await getEntry(locale, 'about');
if (!entry) throw new Error(`Missing about content entry for locale "${locale}"`);
const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} path="about">
  <AboutHero heading={ui[locale].story.heading}>
    <Content />
  </AboutHero>
</BaseLayout>
