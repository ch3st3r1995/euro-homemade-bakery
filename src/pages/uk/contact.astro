---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HoursAddressMap from '../../components/HoursAddressMap.astro';
import ContactForm from '../../components/ContactForm.astro';

const locale = 'uk' as const;
const entry = await getEntry(locale, 'contact');
if (!entry) throw new Error(`Missing contact content entry for locale "${locale}"`);
const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} path="contact">
  <div class="page-intro">
    <h1>{entry.data.title}</h1>
    <Content />
  </div>

  <div class="contact-form-section">
    <ContactForm locale={locale} />
  </div>

  <HoursAddressMap locale={locale} />
</BaseLayout>

<style>
  .contact-form-section {
    padding: 0 32px 40px;
    max-width: 560px;
  }
</style>
