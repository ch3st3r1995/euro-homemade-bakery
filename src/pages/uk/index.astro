---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DepartmentSection from '../../components/DepartmentSection.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import HoursAddressMap from '../../components/HoursAddressMap.astro';
import OrderOnlineLinks from '../../components/OrderOnlineLinks.astro';

const locale = 'uk' as const;
const entry = await getEntry(locale, 'home');
if (!entry) throw new Error(`Missing home content entry for locale "${locale}"`);
if (entry.data.page !== 'home') throw new Error('home.md frontmatter must have page: home');
const { Content } = await render(entry);
const { heroHeading, heroSubheading, departments } = entry.data;
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} path="">
  <section class="hero">
    <img src="/images/hero/placeholder-1.svg" alt="" />
    <h1>{heroHeading}</h1>
    <p>{heroSubheading}</p>
    <OrderOnlineLinks locale={locale} />
  </section>
  <Content />
  <PromoBanner locale={locale} />
  <DepartmentSection department="bakery" heading={departments.bakery.heading} description={departments.bakery.description} />
  <DepartmentSection department="deli" heading={departments.deli.heading} description={departments.deli.description} />
  <DepartmentSection department="grocery" heading={departments.grocery.heading} description={departments.grocery.description} />
  <HoursAddressMap locale={locale} />
</BaseLayout>
