---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'uk' as const;
const entry = await getEntry(locale, 'about');
if (!entry) throw new Error(`Missing about content entry for locale "${locale}"`);
const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} path="about">
  <h1>{entry.data.title}</h1>
  <img src="/images/history/placeholder-1.svg" alt="" />
  <Content />
</BaseLayout>
