---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'uk' as const;
const entry = await getEntry(locale, 'catering');
if (!entry) throw new Error(`Missing catering content entry for locale "${locale}"`);
const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} path="catering">
  <h1>{entry.data.title}</h1>
  <img src="/images/catering/placeholder-1.svg" alt="" />
  <Content />
</BaseLayout>
